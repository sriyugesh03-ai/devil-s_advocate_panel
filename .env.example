# ==========================================
# Devil's Advocate Panel - Environment Variables
# ==========================================

# 1. LLM Providers (Provide at least one)
GEMINI_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_PROVIDER=groq
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# 2. Production MongoDB Atlas Configuration
# Example Atlas SRV URI: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/devils_advocate?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_URL=
MONGODB_DB_NAME=devils_advocate

# 3. Clerk Authentication (Get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER=

# 4. LangSmith Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devils-advocate-panel

# 5. Vector Store Path
VECTOR_STORE_PATH=./data/vectorstore

# 6. Server Configuration
HOST=0.0.0.0
PORT=8999
CORS_ORIGINS=http://localhost:3000, http://127.0.0.1:3000
ENVIRONMENT=production

# 7. Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8999

